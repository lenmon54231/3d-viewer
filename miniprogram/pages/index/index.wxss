/* pages/index/index.wxss */
.page {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #101216;
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

.tabs {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 16rpx;
}

.tab {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #9aa3b2;
  background: #1c2027;
  transition: all 0.2s;
}

.tab-active {
  color: #ffffff;
  background: #33445f;
}

.viewer {
  flex: 1;
  width: 100vw;
  display: block;
}
