/* pages/index/index.wxss */
.page {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #101216;
}

.viewer {
  flex: 1;
  width: 100vw;
  display: block;
}

/* 底部模型切换栏：避开 iPhone 底部安全区（Home 指示条） */
.tabs {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(16, 18, 22, 0.9);
}

.tab {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #9aa3b2;
  background: #1c2027;
  transition: all 0.2s;
}

.tab-active {
  color: #ffffff;
  background: #33445f;
}
