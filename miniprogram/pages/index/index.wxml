<view class="page">
  <three-viewer
    class="viewer"
    src="{{ active.url }}"
    background="{{ active.background }}"
    light-rig="{{ active.lightRig }}"
    exposure="{{ active.exposure }}"
    env-intensity="{{ active.envIntensity }}"
    double-side="{{ !!active.doubleSide }}"
    solid="{{ !!active.solid }}"
    autoplay="{{ false }}"
    bindload="onViewerLoad"
    binderror="onViewerError" />

  <view class="tabs">
    <view
      wx:for="{{ models }}"
      wx:key="key"
      class="tab {{ current === index ? 'tab-active' : '' }}"
      data-index="{{ index }}"
      bindtap="switchModel">{{ item.name }}</view>
  </view>
</view>
